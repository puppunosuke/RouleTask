{
  "manifest_version": 3,
  "name": "RouleTask",
  "version": "1.0.0",
  "description": "スロット風タスクリマインダー — 毎日のタスクをランダムに決定",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RouleTask",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
